<mvc:View
    xmlns:core="sap.ui.core"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:uxap="sap.uxap"
    xmlns:macros="sap.fe.macros"
    controllerName="supplierintelhub.ext.view.SupplierObjectPage">
    <uxap:ObjectPageLayout
        id="supplierObjectPage"
        showTitleInHeaderContent="true"
        upperCaseAnchorBar="false"
        enableLazyLoading="false">
        <uxap:headerTitle>
            <uxap:ObjectPageDynamicHeaderTitle id="_IDGenObjectPageDynamicHeaderTitle">
                <uxap:heading>
                    <Title id="_IDGenTitle" text="{name}" level="H2"/>
                </uxap:heading>
                <uxap:snappedContent>
                    <Text id="_IDGenText" text="{segmentName}"/>
                </uxap:snappedContent>
                <uxap:expandedContent>
                    <Text id="_IDGenText1" text="{segmentName}"/>
                </uxap:expandedContent>
                <uxap:actions>
                    <ObjectStatus id="_IDGenObjectStatus"
                        text="{complianceStatus}"
                        state="{= ${complianceStatus} === 'OK' ? 'Success' : (${complianceStatus} === 'Expired' ? 'Error' : 'Warning') }"/>
                </uxap:actions>
            </uxap:ObjectPageDynamicHeaderTitle>
        </uxap:headerTitle>
        <uxap:headerContent>
            <FlexBox id="headerContentFlexBox" wrap="Wrap" alignItems="Start" class="sapUiSmallMarginTop">
                <VBox id="_IDGenVBox" class="sapUiLargeMarginEnd">
                    <Label id="_IDGenLabel" text="Category"/>
                    <Text id="_IDGenText2" text="{category}"/>
                    <Label id="_IDGenLabel1" text="Subcategory" class="sapUiSmallMarginTop"/>
                    <Text id="_IDGenText3" text="{subcategory}"/>
                </VBox>
                <VBox id="_IDGenVBox1" class="sapUiLargeMarginEnd">
                    <Label id="_IDGenLabel2" text="Main Supplies"/>
                    <Text id="_IDGenText4" text="{mainSupplies}"/>
                    <Label id="_IDGenLabel3" text="Supplier Responsible" class="sapUiSmallMarginTop"/>
                    <Text id="_IDGenText5" text="{responsible}"/>
                </VBox>
                <VBox id="_IDGenVBox2" class="sapUiLargeMarginEnd">
                    <Label id="_IDGenLabel4" text="Next Review"/>
                    <Text id="_IDGenText6" text="{nextReview}"/>
                    <Label id="_IDGenLabel5" text="Danfoss Plant" class="sapUiSmallMarginTop"/>
                    <Text id="_IDGenText7" text="{plantName}"/>
                </VBox>
                <VBox id="_IDGenVBox3" class="sapUiLargeMarginEnd">
                    <Label id="_IDGenLabel6" text="Active Quality Claims"/>
                    <ObjectNumber id="_IDGenObjectNumber" number="{activeQualityClaims}"/>
                </VBox>
                <VBox id="_IDGenVBox4">
                    <Label id="_IDGenLabel7" text="Score"/>
                    <ObjectNumber id="_IDGenObjectNumber1" number="{score}" unit="/ 10" emphasized="true"/>
                </VBox>
            </FlexBox>
        </uxap:headerContent>
        <uxap:sections>
            <uxap:ObjectPageSection id="_IDGenObjectPageSection1" title="Spend Development" titleUppercase="false">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection id="_IDGenObjectPageSubSection">
                        <VBox id="_IDGenVBox5">
                            <OverflowToolbar id="_IDGenOverflowToolbar">
                                <ToolbarSpacer id="_IDGenToolbarSpacer"/>
                                <SegmentedButton
                                    id="spendPeriod"
                                    selectedKey="all"
                                    selectionChange=".onSpendPeriodChange">
                                    <items>
                                        <SegmentedButtonItem id="_IDGenSegmentedButtonItem" key="3" text="Last 3 Years"/>
                                        <SegmentedButtonItem id="_IDGenSegmentedButtonItem1" key="5" text="Last 5 Years"/>
                                        <SegmentedButtonItem id="_IDGenSegmentedButtonItem2" key="all" text="All"/>
                                    </items>
                                </SegmentedButton>
                            </OverflowToolbar>
                            <macros:FilterBar
                                id="spendFilterBar"
                                metaPath="spendData/@com.sap.vocabularies.UI.v1.SelectionFields"
                                visible="false"
                                liveMode="true"/>
                            <VBox id="spendChartBox" width="100%" class="sapUiSmallMarginTop">
                                <macros:Chart
                                    id="spendChart"
                                    metaPath="spendData/@com.sap.vocabularies.UI.v1.Chart#SpendTrend"
                                        filterBar="spendFilterBar"
                                    selectionMode="None"/>
                            </VBox>
                        </VBox>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>
            <uxap:ObjectPageSection id="_IDGenObjectPageSection2" title="Parts Per Million" titleUppercase="false">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection id="_IDGenObjectPageSubSection1">
                        <VBox id="ppmChartBox" width="100%" class="sapUiSmallMarginTop">
                            <macros:Chart
                                id="ppmTrendChart"
                                metaPath="ppmData/@com.sap.vocabularies.UI.v1.Chart#PpmTrend"
                                selectionMode="None"/>
                        </VBox>
                        <FlexBox id="_IDGenFlexBox" wrap="Wrap" alignItems="Stretch" fitContainer="true" class="sapUiSmallMarginTop">
                            <VBox id="_IDGenVBox7" width="100%">
                                <macros:Chart
                                    id="ppmYoYChart"
                                    metaPath="ppmData/@com.sap.vocabularies.UI.v1.Chart#PpmYoY"
                                    selectionMode="None"/>
                            </VBox>
                        </FlexBox>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>
            <uxap:ObjectPageSection id="opmSection" title="Occurrence Per Million" titleUppercase="false">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection id="opmSubSection">
                        <VBox id="opmChartBox" width="100%" class="sapUiSmallMarginTop">
                            <macros:Chart
                                id="opmTrendChart"
                                metaPath="opmData/@com.sap.vocabularies.UI.v1.Chart#OpmTrend"
                                selectionMode="None"/>
                        </VBox>
                        <FlexBox id="opmFlexBox" wrap="Wrap" alignItems="Stretch" fitContainer="true" class="sapUiSmallMarginTop">
                            <VBox id="opmRollingBox" width="100%">
                                <macros:Chart
                                    id="opmRollingChart"
                                    metaPath="opmData/@com.sap.vocabularies.UI.v1.Chart#OpmRolling"
                                    selectionMode="None"/>
                            </VBox>
                        </FlexBox>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>
            <uxap:ObjectPageSection id="otdSection" title="On Time Delivery" titleUppercase="false">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection id="otdSubSection">
                        <VBox id="otdSectionBox" fitContainer="true">
                            <VBox id="otdChartBox" width="100%" class="sapUiSmallMarginTop">
                                <macros:Chart
                                    id="otdTrendChart"
                                    metaPath="otdData/@com.sap.vocabularies.UI.v1.Chart#OtdTrend"
                                    selectionMode="None"/>
                            </VBox>
                            <FlexBox id="otdTopRow" wrap="Wrap" alignItems="Stretch" fitContainer="true">
                                <VBox id="otdKpiBox" width="100%" minWidth="18rem">
                                    <Panel id="otdKpiPanel" backgroundDesign="Solid" class="sapUiSmallMarginTop">
                                        <VBox id="otdKpiContent" class="sapUiSmallMargin">
                                            <Title id="otdKpiTitle" text="On Time Delivery - Average Results" level="H3"/>
                                            <Text id="otdKpiPeriod"
                                                text="{otdKpi>/periodLabel}"
                                                class="sapUiTinyMarginBottom sapUiContentLabelColor"/>
                                            <HBox id="otdKpiNumberRow" alignItems="Center" visible="{otdKpi>/hasData}">
                                                <NumericContent
                                                    id="otdKpiValue"
                                                    value="{otdKpi>/averageText}"
                                                    scale="%"
                                                    indicator="{otdKpi>/indicator}"
                                                    valueColor="{otdKpi>/valueColor}"
                                                    icon="sap-icon://line-chart"
                                                    withMargin="false"
                                                    nullifyValue="false"/>
                                                <VBox id="otdKpiTrendBox" class="sapUiSmallMarginBegin">
                                                    <Text id="otdKpiTrendText" text="{otdKpi>/trendText}"/>
                                                    <Text id="otdKpiDeltaText"
                                                        text="{otdKpi>/deltaText}"
                                                        class="sapUiContentLabelColor"/>
                                                </VBox>
                                            </HBox>
                                            <Text
                                                id="otdKpiNoData"
                                                visible="{= !${otdKpi>/hasData} }"
                                                text="No on-time delivery data reported for this supplier."
                                                class="sapUiSmallMarginTop sapUiContentLabelColor"/>
                                            <macros:Chart
                                                id="otdAverageChart"
                                                metaPath="otdData/@com.sap.vocabularies.UI.v1.Chart#OtdAverage"
                                                selectionMode="None"/>
                                        </VBox>
                                    </Panel>
                                </VBox>
                            </FlexBox>
                        </VBox>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>
            <uxap:ObjectPageSection id="complianceSection" title="Overall Compliance" titleUppercase="false">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection id="complianceSubSection">

                        <macros:Table
                            id="complianceTable"
                            metaPath="complianceItems/@com.sap.vocabularies.UI.v1.PresentationVariant#Ordered"
                            type="ResponsiveTable"
                            readOnly="true"
                            selectionMode="None"
                            headerVisible="false"
                            isSearchable="false"
                            personalization="false"
                            variantManagement="None"
                            enableExport="false"
                            enableFullScreen="false"
                            enablePaste="false"/>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>
        </uxap:sections>
    </uxap:ObjectPageLayout>
</mvc:View>
